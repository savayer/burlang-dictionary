{
  "name": "burlang-dictionary",
  "version": "1.0.0",
  "scripts": {
    "dev": "npx expo start",
    "dev:clear": "npx expo start --clear",
    "build-ios": "eas build -p ios --profile prod",
    "build-ios-local": "eas build -p ios --profile prod --local",
    "build-android": "eas build -p android --profile prod",
    "build-android-local": "eas build -p android --profile prod --local",
    "dev-ios": "eas build -p ios --profile dev-ios --local",
    "dev-ios-device": "eas build -p ios --profile dev-ios-device --local",
    "dev-android": "eas build -p android --profile dev --local",
    "apk-prod": "eas build -p android --profile apk-prod --local",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "tsc --noemit"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.0.0",
    "@react-navigation/native": "^7.0.0",
    "@shopify/react-native-skia": "2.4.18",
    "@types/react": "~19.2.0",
    "axios": "^1.3.5",
    "expo": "~55.0.0",
    "expo-dev-client": "~55.0.19",
    "expo-linear-gradient": "~55.0.9",
    "expo-splash-screen": "~55.0.0",
    "expo-status-bar": "~55.0.0",
    "expo-updates": "~55.0.16",
    "expo-web-browser": "~55.0.0",
    "i18n-js": "^4.2.0",
    "nativewind": "^4.2.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.4",
    "react-native-confetti-cannon": "^1.5.2",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-worklets": "0.7.2",
    "tailwind-merge": "^3.5.0",
    "typescript": "~5.9.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "prettier": "^2.7.1",
    "react-native-dotenv": "^3.4.2",
    "tailwindcss": "^3.4.0"
  },
  "private": true
}

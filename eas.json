{
  "cli": {
    "version": ">= 3.5.2",
    "appVersionSource": "local"
  },
  "build": {
    "dev": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "dev-ios": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      }
    },
    "dev-ios-device": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": false
      }
    },
    "prod": {
      "channel": "production",
      "android": {
        "buildType": "app-bundle"
      }
    },
    "production": {}
  },
  "submit": {
    "production": {}
  }
}
